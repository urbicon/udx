{
  "name": "@urbicon-ui/udx-workspace",
  "description": "Shared development harness for Bun/Svelte projects (configs, CLI)",
  "private": true,
  "version": "0.3.1",
  "type": "module",
  "author": "Felix Urban",
  "license": "MIT",
  "workspaces": {
    "packages": [
      "packages/*"
    ],
    "catalog": {
      "@biomejs/biome": "^2.5.0",
      "@commitlint/cli": "^21.0.2",
      "@commitlint/config-conventional": "^21.0.2",
      "@types/bun": "^1.3.14",
      "@types/node": "^25.9.3",
      "git-cliff": "^2.13.1",
      "lefthook": "^2.1.9",
      "typescript": "^6.0.3"
    },
    "catalogs": {
      "svelte": {
        "prettier": "^3.8.4",
        "prettier-plugin-svelte": "^4.0.1",
        "prettier-plugin-tailwindcss": "^0.8.0",
        "svelte-check": "^4.3.1"
      }
    }
  },
  "scripts": {
    "build": "bun --filter='@urbicon-ui/udx' run build",
    "format": "biome format --write .",
    "lint": "biome check .",
    "fix": "biome check --write .",
    "check": "bun --filter='*' run check",
    "test": "bun --filter='*' run test",
    "bump": "bash scripts/bump.sh patch",
    "bump:minor": "bash scripts/bump.sh minor",
    "bump:major": "bash scripts/bump.sh major",
    "release": "bash scripts/bump.sh patch && git push --follow-tags && bun run release:publish",
    "release:minor": "bash scripts/bump.sh minor && git push --follow-tags && bun run release:publish",
    "release:major": "bash scripts/bump.sh major && git push --follow-tags && bun run release:publish",
    "release:publish": "bash scripts/publish.sh",
    "stack:update": "bun run scripts/stack-update.ts",
    "changelog": "git-cliff --output CHANGELOG.md",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@commitlint/cli": "catalog:",
    "@commitlint/config-conventional": "catalog:",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "@urbicon-ui/biome-config": "workspace:*",
    "@urbicon-ui/commitlint-config": "workspace:*",
    "@urbicon-ui/tsconfig": "workspace:*",
    "git-cliff": "catalog:",
    "lefthook": "catalog:",
    "typescript": "catalog:"
  }
}
