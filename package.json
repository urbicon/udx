{
  "name": "@urbicon/udx-workspace",
  "description": "Geteiltes Entwicklungs-Harness für Bun/Svelte-Projekte (Configs, CLI, Claude-Plugin)",
  "private": true,
  "version": "0.1.3",
  "type": "module",
  "author": "Felix Urban",
  "license": "MIT",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "bun --filter='@urbicon/udx' run build",
    "format": "biome format --write .",
    "lint": "biome check .",
    "fix": "biome check --write .",
    "check": "bun --filter='*' run check",
    "test": "bun --filter='*' run test",
    "bump": "bash scripts/bump.sh patch",
    "bump:minor": "bash scripts/bump.sh minor",
    "bump:major": "bash scripts/bump.sh major",
    "release:publish": "bash scripts/publish.sh",
    "changelog": "git-cliff --output CHANGELOG.md",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "@types/node": "^25.9.2",
    "@urbicon/biome-config": "workspace:*",
    "@urbicon/commitlint-config": "workspace:*",
    "@urbicon/tsconfig": "workspace:*",
    "bun-types": "^1.3.14",
    "git-cliff": "^2.13.1",
    "lefthook": "^1.13.6",
    "typescript": "^6.0.3"
  }
}
