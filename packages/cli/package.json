{
  "name": "@urbicon-ui/udx",
  "version": "0.3.0",
  "description": "CLI for setting up and syncing the urbicon development harness",
  "type": "module",
  "author": "Felix Urban",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/urbicon/udx.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/urbicon/udx/tree/main/packages/cli",
  "bugs": {
    "url": "https://github.com/urbicon/udx/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "udx": "dist/bin/udx.js"
  },
  "files": [
    "dist/**/*"
  ],
  "scripts": {
    "build": "bun build ./src/bin/udx.ts --target=bun --outdir=dist/bin --minify --sourcemap=linked && chmod +x dist/bin/udx.js",
    "dev": "bun run ./src/bin/udx.ts",
    "check": "tsc --noEmit",
    "test": "bun test",
    "clean": "rm -rf dist node_modules",
    "prepublishOnly": "bun run build"
  },
  "keywords": [
    "urbicon",
    "udx",
    "cli",
    "scaffolding",
    "harness"
  ],
  "devDependencies": {
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "@urbicon-ui/tsconfig": "workspace:*",
    "typescript": "catalog:"
  }
}
