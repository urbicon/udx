{
  "name": "@urbicon/svelte-fixture",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Internal smoke-test package: dogfoods the prescribed Svelte tool stack (catalog:svelte) and keeps its versions visible to `bun outdated` (references the svelte catalog).",
  "scripts": {
    "check": "prettier --check . && svelte-check --tsconfig ./tsconfig.json",
    "test": "true",
    "format": "biome format --write . && prettier --write \"**/*.svelte\"",
    "lint": "biome check . && svelte-check --tsconfig ./tsconfig.json"
  },
  "devDependencies": {
    "prettier": "catalog:svelte",
    "prettier-plugin-svelte": "catalog:svelte",
    "prettier-plugin-tailwindcss": "catalog:svelte",
    "svelte": "^5",
    "svelte-check": "catalog:svelte"
  }
}
